# ====================================================================
# UniBet — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ====================================================================

# 1. Aplicación
# URL pública exacta (sin barra final). En producción DEBE ser HTTPS y
# coincidir con la URL autorizada en Supabase Auth y Binance Pay.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Supabase (base de datos y autenticación)
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"
# Secreta: solo la usan los route handlers del servidor. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"

# En Supabase Auth -> URL Configuration añade:
#   Site URL:      https://tu-dominio.com
#   Redirect URLs: https://tu-dominio.com  (y http://localhost:3000 en desarrollo)
# Habilita el proveedor Google si quieres acceso con un clic.

# 3. Binance Pay (Merchant Portal)
# https://merchant.binance.com
BINANCE_BASE_URL="https://bpay.binanceapi.com"
BINANCE_PAY_API_KEY="tu-binance-merchant-api-key"
BINANCE_PAY_API_SECRET="tu-binance-merchant-api-secret"

# 4. Verificación de webhooks de Binance Pay (RSA-SHA256)
# El webhook se valida con los certificados públicos que Binance publica en
# /binancepay/openapi/certificates. Opcionalmente puedes fijar uno:
#   BINANCE_PAY_CERT_SN="certificate-serial-number"
#   BINANCE_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Si defines CERT_SN, solo se aceptará ese certificado; si defines PUBLIC_KEY
# sin CERT_SN, se usará como clave adicional. No se usa HMAC para webhooks.
BINANCE_PAY_CERT_SN=""
BINANCE_PAY_PUBLIC_KEY=""

# URL de webhook a configurar en el Merchant Portal:
#   https://tu-dominio.com/api/webhooks/binance
# Evento requerido: PAY_SUCCESS.

# 5. Notificaciones de Telegram para grupo de amigos (Opcional)
# Crea un bot con @BotFather en Telegram para recibir avisos de nuevos mercados y premios:
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ====================================================================
# Seguridad operativa
# - Ejecuta schema.sql completo en el SQL Editor de Supabase.
# - Asigna el primer ADMIN manualmente:
#     UPDATE public.users SET role = 'ADMIN' WHERE email = 'tu-correo@gmail.com';
# - Los retiros inciertos quedan PENDING y se concilian desde el panel admin.
# ====================================================================
